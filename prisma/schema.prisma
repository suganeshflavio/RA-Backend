// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db` output   = "../src/generated/prisma" role         String   @default("student")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum OptionChoice {
  A
  B
  C
  D
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id String @id @default(cuid())

  name String

  email String @unique

  mobile String? @unique

  class String?

  password String

  role Role @default(STUDENT)

  deviceId String?

  accesses UserAccess[]

  notesAccesses UserNotesAccess[]

  mcqTestAccesses UserMcqTestAccess[]

  sessionToken String?

  isActive Boolean @default(true)

  isAccess Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  comments Comment[]

  testimonials Testimonial[]

  studentAttempts StudentAttempt[]
}

// Content hierarchy: Subject -> Class -> Chapter -> Topic.
// A Topic is the "video name" node under which independently
// created Video / MCQ test / Notes are optionally linked.

model Subject {
  id String @id @default(cuid())

  name String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  classes Class[]

  courses CourseSubject[]
}

model Class {
  id String @id @default(cuid())

  name String

  subjectId String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  chapters Chapter[]

  courseSubjects CourseSubject[]

  courseVideos CourseVideo[]

  courseNotes CourseNotes[]

  courseMcqTests CourseMcqTest[]

  @@unique([subjectId, name])
  @@index([subjectId])
}

model Chapter {
  id String @id @default(cuid())

  name String

  classId String

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  topics Topic[]

  @@unique([classId, name])
  @@index([classId])
}

model Topic {
  id String @id @default(cuid())

  name String

  chapterId String

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  order Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  videos Video[]

  mcqTests TestQuestion[]

  notes Notes[]

  courseTopics CourseTopic[]

  @@index([chapterId])
}

// Independent, reusable content units. Each can be linked to any
// number of Topics (content library) and any number of Courses
// (course assembly) via the join tables below.

model Video {
  id String @id @default(cuid())

  videoName String

  videoFileId String?

  videoFileName String?

  videoSize Int?

  description String?

  duration String?

  isActive Boolean @default(true)

  isPreview Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  topics Topic[]

  courses CourseVideo[]

  userAccesses UserAccess[]

  comments Comment[]

  attempts StudentAttempt[]
}

// A B2 file backing an inline image/diagram embedded in rich-text content
// (MCQ question/option/explanation HTML). The image's <img src> in that
// stored HTML points at a stable `/api/uploads/image/:id` URL rather than a
// raw B2 link, since B2 is a private bucket and signed URLs expire — this
// row lets that stable URL redirect to a freshly-minted signed URL on every
// request, the same way Video/Notes already resolve fresh URLs on read.
model InlineImage {
  id String @id @default(cuid())

  fileId String

  fileName String

  createdAt DateTime @default(now())
}

model Notes {
  id String @id @default(cuid())

  title String

  notesUrl String?

  notesFileId String?

  notesFileName String?

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  topics Topic[]

  courses CourseNotes[]

  userAccesses UserNotesAccess[]
}

model Course {
  id String @id @default(cuid())

  courseName String @unique

  thumbnail String?

  accessType String?

  price Int?

  strikePrice Int?

  userAccesses UserAccess[]

  userNotesAccesses UserNotesAccess[]

  userMcqTestAccesses UserMcqTestAccess[]

  validityMonths Int?

  enableEmi Boolean?

  installments Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  subjects CourseSubject[]

  topics CourseTopic[]

  videos CourseVideo[]

  notes CourseNotes[]

  mcqTests CourseMcqTest[]
}

model CourseSubject {
  id String @id @default(cuid())

  courseId String

  subjectId String

  // Optional: scopes this link to one Class of the subject (e.g. a course
  // that only teaches 11th-grade English). Null means unrestricted — the
  // app falls back to auto-resolving the class from the student's profile.
  // Linking the same subject multiple times with different classIds lets a
  // single course bundle more than one grade of the same subject.
  classId String?

  order Int?

  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([courseId, subjectId, classId])
  @@index([courseId])
  @@index([subjectId])
  @@index([classId])
}

// A Topic belongs to exactly one Chapter -> Class -> Subject, so linking a
// Topic directly is unambiguous. This is the primary way a course now
// grants access to the Subject/Class/Chapter/Topic hierarchy in the admin
// UI — the Subject/Class/Chapter pickers there are just how you find the
// Topic, not separate grants of their own.
model CourseTopic {
  id String @id @default(cuid())

  courseId String

  topicId String

  order Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([courseId, topicId])
  @@index([courseId])
  @@index([topicId])
}

model CourseVideo {
  id String @id @default(cuid())

  courseId String

  videoId String

  // Optional: which Class this grant is for (same rationale as
  // CourseSubject.classId — a video can appear under more than one class's
  // topics, so this disambiguates which one the course is granting).
  classId String?

  order Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([courseId, videoId, classId])
  @@index([courseId])
  @@index([videoId])
  @@index([classId])
}

model CourseNotes {
  id String @id @default(cuid())

  courseId String

  notesId String

  // See CourseVideo.classId.
  classId String?

  order Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  notes Notes @relation(fields: [notesId], references: [id], onDelete: Cascade)

  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([courseId, notesId, classId])
  @@index([courseId])
  @@index([notesId])
  @@index([classId])
}

model CourseMcqTest {
  id String @id @default(cuid())

  courseId String

  testId String

  // See CourseVideo.classId.
  classId String?

  order Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  test TestQuestion @relation(fields: [testId], references: [id], onDelete: Cascade)

  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([courseId, testId, classId])
  @@index([courseId])
  @@index([testId])
  @@index([classId])
}

model Comment {
  id String @id @default(cuid())

  videoId String
  userId  String

  message String

  parentId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  replies Comment[] @relation("CommentReplies")

  @@index([videoId])
  @@index([userId])
  @@index([parentId])
}

model Testimonial {
  id String @id @default(cuid())

  userId String

  star Int

  review String

  isActive Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Enquiry {
  id String @id @default(cuid())

  name String

  email String

  category String

  message String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
}

model UserAccess {
  id String @id @default(cuid())

  userId   String
  courseId String
  videoId  String

  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId, videoId])
  @@index([userId])
  @@index([courseId])
  @@index([videoId])
}

model UserNotesAccess {
  id String @id @default(cuid())

  userId   String
  courseId String
  notesId  String

  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  notes Notes @relation(fields: [notesId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId, notesId])
  @@index([userId])
  @@index([courseId])
  @@index([notesId])
}

model UserMcqTestAccess {
  id String @id @default(cuid())

  userId   String
  courseId String
  testId   String

  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  test TestQuestion @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId, testId])
  @@index([userId])
  @@index([courseId])
  @@index([testId])
}

model TestQuestion {
  id String @id @default(cuid())

  testName String

  marksPerQuestion Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  topics Topic[]

  courses CourseMcqTest[]

  questions TestQuestionItem[]

  attempts StudentAttempt[]

  userAccesses UserMcqTestAccess[]
}

model TestQuestionItem {
  id String @id @default(cuid())

  testId String

  question String

  optionA String

  optionB String

  optionC String

  optionD String

  correctOption OptionChoice

  explanation String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  test TestQuestion @relation(fields: [testId], references: [id], onDelete: Cascade)

  attemptAnswers StudentAttemptAnswer[]

  @@index([testId])
}

model StudentAttempt {
  id String @id @default(cuid())

  studentId String

  videoId String?

  testId String

  status AttemptStatus @default(COMPLETED)

  totalQuestions Int

  correctAnswers Int

  wrongAnswers Int

  marksPerQuestion Int

  totalMarks Int

  obtainedMarks Int

  startedAt DateTime

  submittedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  video Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)

  test TestQuestion @relation(fields: [testId], references: [id], onDelete: Cascade)

  answers StudentAttemptAnswer[]

  @@index([studentId])
  @@index([videoId])
  @@index([testId])
  @@index([status])
}

model StudentAttemptAnswer {
  id String @id @default(cuid())

  attemptId String

  questionId String

  selectedOption OptionChoice

  isCorrect Boolean

  createdAt DateTime @default(now())

  attempt StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  question TestQuestionItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}
